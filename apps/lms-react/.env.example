# Copy to .env.local. Every VITE_* value ends up in the browser bundle: never put a secret here.

# Production: the API's public URL, e.g. https://lms.example.com/api. Leave unset in development — the app then
# calls /api on its own origin and the Vite dev server forwards it (see VITE_API_PROXY_TARGET).
VITE_API_BASE_URL=

# Development only: where the dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Product name shown in the document title.
VITE_APP_NAME=ShubhLMS
