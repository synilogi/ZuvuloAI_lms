# "mock" uses in-memory services with simulated latency. "http" talks to the real API in apps/api
# (start it with `npm run dev` there first — see the repo README).
VITE_API_MODE=mock
VITE_API_BASE_URL=http://localhost:4000

# The live room's video service is configured on the API (JITSI_DOMAIN / JAAS_* in apps/api/.env): it hands
# the browser the server, room and token for each class.
