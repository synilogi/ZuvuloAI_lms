# SQLite file used by Prisma (relative to apps/api/prisma)
DATABASE_URL="mysql://root:root@127.0.0.1:3306/zuviloai_dev"
# Long random string. The API refuses to start in production with the dev default.
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"
# Base URL of the web app, used in emails (defaults to CORS_ORIGIN)
APP_URL="http://localhost:5173"
# outbox (store only, default) | log (store + print to the server log; the delivery worker marks it sent)
# | smtp (deliver through an SMTP relay: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM)
MAIL_TRANSPORT=outbox
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ZuviloAI <noreply@example.com>"
# Self-registration emails a 6-digit code before any account exists: learners and
# instructors who join through a join link, invitation or course link. `off` skips the code — only for a deployment
# with no email delivery yet. Never the default.
# SIGNUP_EMAIL_VERIFICATION=on
# A static fallback code for the listed test accounts, when the emailed code does not arrive (lib/testOtp.ts). The
# emailed code still works and is still sent; the static one is checked against the same expiry and attempt limits,
# and only for the addresses in TEST_OTP_EMAIL (comma-separated), or for every address with TEST_OTP_EMAIL=* — which
# only a development machine accepts. Runs only with NODE_ENV=development or test, never on a staging or production
# server (APP_ENV=staging or production, or any zuviloai.com address, refuses it): the API refuses to start with
# either set anywhere else. Keep the real values in apps/api/.env only — never in git, the apps, or a server.
# TEST_OTP_EMAIL="qa-one@example.com,qa-two@example.com"
# TEST_OTP_CODE=   (exactly 6 digits)
# Registrations an hour per email address, from any client.
# RATE_LIMIT_EMAIL_MAX=10
# Where the website's demo, sales and support requests are emailed as they arrive (SAAS-027). They are always in
# the Super Admin's inbox (/superadmin/inquiries) as well.
# SALES_NOTIFY_EMAIL="sales@example.com"
# Push notifications (SAAS-021): `fcm` with FCM_SERVICE_ACCOUNT (the service-account JSON, raw or base64).
# Unset: no push is queued or sent. Never commit the service account.
PUSH_PROVIDER=
FCM_SERVICE_ACCOUNT=
PORT=4000
# The web app's origin (exactly one)
CORS_ORIGIN="http://localhost:5173"
# development | test | production
NODE_ENV=development
# Set to the number of proxy hops (1 behind nginx) so rate limiting sees the real client ip
TRUST_PROXY=0
# Rate limiting per client ip per window (defaults: 1000 requests, 30 auth attempts, 15 minutes)
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=30
# Failed sign-ins per account per window, from any client (default 10).
# RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Where uploaded media is stored (default: apps/api/uploads)
UPLOAD_DIR=./uploads

# off disables the in-process live-class reminder scheduler
LIVE_REMINDERS=on

# The built-in live room's video service (lib/liveRoom.ts). With nothing set, classes use the public Jitsi
# server JITSI_DOMAIN (meet.jit.si): fine for trying it out, but a host must sign in there, embedded calls are
# time-limited and nothing is recorded — so a production process refuses it (start and join answer 503
# LIVE_ROOM_NOT_CONFIGURED) unless LIVE_ROOM_PUBLIC_JITSI=allow. A JaaS key that is not an RSA private key stops boot. For production use 8x8 Jitsi as a Service (jaas.8x8.vc): set all three
# below and every join is signed — the host moderates, learners don't. Add the webhook secret (JaaS Console →
# Webhooks, pointed at <API>/webhooks/jaas with RECORDING_UPLOADED) to keep recordings for LIVE_RECORDING_DAYS.
# JITSI_DOMAIN=meet.jit.si
# JAAS_APP_ID=vpaas-magic-cookie-...
# JAAS_KID=abc123                     (the API key's id; the token's kid is <JAAS_APP_ID>/<JAAS_KID>)
# JAAS_PRIVATE_KEY_FILE=/path/to/jaas-private.pem   (or JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...")
# JAAS_WEBHOOK_SECRET=
# LIVE_RECORDING_DAYS=30

# Read only by `npm run superadmin:create -w @syniastrolms/api`, which provisions the platform's
# Super Admin account. Pass them on the command line for that one run rather than storing a live
# password here; the script never prints or writes the password itself.
# SUPERADMIN_EMAIL="you@example.com"
# SUPERADMIN_PASSWORD=""
# SUPERADMIN_NAME="Super Admin"
# SUPERADMIN_DESCRIPTOR="Platform admin"

# The platform's one workspace (docs/16, D-PLAT-01): the Tenant row every request runs in. The tenant_foundation
# migration creates it with the slug "default"; `npm run seed:platform` adds it when missing.
DEFAULT_TENANT_SLUG=default

# Tenant scoping is on unless this says "off" — and a production API refuses to start with "off". "off" is the
# rollback switch: new rows are still stamped with the workspace, but reads stop being filtered.
# TENANT_ENFORCEMENT=on

# How the registration code travels (docs/16, D-PLAT-09): `email` is the only channel that exists; `sms` is refused at
# boot until an SMS provider is configured.
# OTP_CHANNEL=email

# The reply-to address on email the platform sends as itself (a super admin's reset link, say) —
# workspace email uses the platform settings' own sender instead.
# PLATFORM_REPLY_TO="support@example.com"

# Online payment (SAAS-009, SAAS-017). Payment gateways — which one is active, and their API keys and webhook
# secrets — are configured by a Super Admin at /superadmin/payment-gateways and stored encrypted in the
# database. They are never set here. What the deployment supplies is the key that encrypts them: 32 random
# bytes as 64 hex characters (`openssl rand -hex 32`). Keep it in apps/api/.env, which git ignores, and keep a
# copy with your other deployment secrets: without the same key, stored credentials cannot be read and must
# be entered again. Unset: gateways cannot be configured, and invoices are paid by hand.
# PAYMENT_CREDENTIALS_KEY=

# The sandbox payment gateway (SAAS-030), for development and end-to-end tests: while no real gateway is active,
# checkout goes to a test page (/sandbox-checkout/:orderId) that pays, declines or cancels, and reports the outcome
# by signed webhook like a real gateway. Moves no money. The API refuses to start with it in production.
# PAYMENT_SANDBOX=on

# Android App Links: SHA-256 signing-certificate fingerprints served at /.well-known/assetlinks.json when WEB_DIST is set
# (see deploy/api.env.example). Unset: the file 404s and links open in the browser.
# ANDROID_APP_LINK_SHA256=

# ─── Less often needed ───
# A second copy of operational signals, one JSON line each, in this file. Unset: the server log only.
# OBSERVABILITY_LOG=
# Overrides which webhook URL the sandbox gateway posts to (tests and unusual proxies).
# SANDBOX_WEBHOOK_URL=
# Force the payment provider instead of the one active in the database (tests).
# PAYMENT_PROVIDER=
# Keeps the demo seed quiet.
# SEED_QUIET=1
# Must be set to run scripts/clear-course-data.ts. Destructive: never on production.
# CLEAR_COURSE_DATA=
