// ZuviloAI API — database schema.
//
// Structural, queryable fields (ids, status, dates, foreign keys) are real columns.
// Nested or type-varying shapes that the domain package already types and validates
// (lesson content, quiz questions, rubrics, settings sections, …) are stored as JSON
// text columns and parsed/validated at the boundary — the same pattern the mock
// services use in memory, now persisted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────

/// One academy on the platform. Every academy-owned row carries its id (`tenantId`), and
/// `lib/tenancy.ts` scopes every query to the academy of the signed-in account. The academy that
/// existed before tenancy is Tenant #1 (`tenant-1`), created by the tenant_foundation migration.
model Tenant {
  id              String    @id @default(cuid())
  name            String
  /// Unique across the platform; `DEFAULT_TENANT_SLUG` names the academy anonymous visitors see.
  slug            String    @unique
  status          String    @default("active") // 'active' | 'suspended' | 'archived' — enforced on every request (SAAS-019)
  /// Why the Super Admin last suspended or archived the academy; cleared on reactivation.
  statusReason    String?
  statusChangedAt DateTime?
  ownerUserId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  owner                    User?                      @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  users                    User[]                     @relation("TenantUsers")
  mediaAssetRows           MediaAsset[]
  levelRows                Level[]
  categoryRows             Category[]
  categoryLevelRows        CategoryLevel[]
  instructorRows           Instructor[]
  courseRows               Course[]
  courseInstructorRows     CourseInstructor[]
  chapterRows              Chapter[]
  lessonRows               Lesson[]
  studentRows              Student[]
  enrollmentRows           Enrollment[]
  lessonProgressRows       LessonProgress[]
  lessonNoteRows           LessonNote[]
  lessonBookmarkRows       LessonBookmark[]
  savedCourseRows          SavedCourse[]
  rankRows                 Rank[]
  quizRows                 Quiz[]
  quizAttemptRows          QuizAttempt[]
  quizSessionRows          QuizSession[]
  courseAssignmentRows     CourseAssignment[]
  assignmentDraftRows      AssignmentDraft[]
  submissionRows           Submission[]
  certificateTemplateRows  CertificateTemplate[]
  issuedCertificateRows    IssuedCertificate[]
  liveClassRows            LiveClass[]
  liveRegistrationRows     LiveRegistration[]
  calendarEventRows        CalendarEvent[]
  settingsRows             Settings[]
  adminPermissionRows      AdminPermission[]
  passwordResetTokenRows   PasswordResetToken[]
  userSessionRows          UserSession[]
  deviceTokenRows          DeviceToken[]
  academyPaymentConfigRows AcademyPaymentConfig[]
  academyGatewayCredRows   AcademyGatewayCredential[]
  coursePurchaseRows       CoursePurchase[]
  courseReviewRows         CourseReview[]
  mlmPlanVersionRows       MlmPlanVersion[]
  affiliateRows            Affiliate[]
  mlmPlacementHistoryRows  MlmPlacementHistory[]
  mlmOrderRows             MlmOrder[]
  mlmCvLedgerRows          MlmCvLedger[]
  mlmLegBalanceRows        MlmLegBalance[]
  coursePaymentEventRows   CoursePaymentEvent[]
  couponRows               Coupon[]
  couponRedemptionRows     CouponRedemption[]
  coursePurchaseRefundRows CoursePurchaseRefund[]
  pushDeliveryRows         PushDelivery[]
  notificationSettingsRows NotificationSettings[]
  appNotificationRows      AppNotification[]
  emailOutboxRows          EmailOutbox[]
  subscriptionRows         Subscription[]
  subscriptionEventRows    SubscriptionEvent[]
  planChangeRows           PlanChange[]
  billingProfileRows       BillingProfile[]
  invoiceRows              Invoice[]
  paymentRows              Payment[]
  refundRows               Refund[]
  paymentMethodRows        PaymentMethod[]
  usageGuardRows           UsageGuard[]
  paymentOrderRows         PaymentOrder[]
  inquiryRows              Inquiry[]
  invitationRows           Invitation[]
  pendingAccountRows       PendingAccount[]
  siteContent              SiteContent?
  siteImageRows            SiteImage[]
  blogPostRows             BlogPost[]
  courseBundleRows         CourseBundle[]
  courseBundleCourseRows   CourseBundleCourse[]
  bundlePurchaseRows       BundlePurchase[]
  mlmMatchingRuns          MlmMatchingRun[]
  mlmRankHistory           MlmRankHistory[]
  mlmRewards               MlmReward[]
  mlmCommissions           MlmCommission[]
  mlmWallets               MlmWallet[]
  mlmWalletEntries         MlmWalletEntry[]
  mlmKyc                   MlmKyc[]
  mlmPayoutBatches         MlmPayoutBatch[]
  mlmWithdrawals           MlmWithdrawal[]
  mlmProgramState          MlmProgramState[]

  @@index([status])
}

// ─── Plans ───────────────────────────────────────────────────────────────

/// A platform-level commercial offering (subscriptions.md §4). Platform-owned: no `tenantId`. The
/// row is who the plan is — code, name, status, place in the list. What it costs lives in its
/// `PlanVersion` rows, which are never edited: changing a price adds a version, so every record
/// that points at an older version keeps the terms it was sold on. `lib/plans.ts` is the only writer.
model Plan {
  id           String    @id @default(cuid())
  /// Unique across the platform, in capitals. Fixed once the plan leaves draft.
  code         String    @unique
  name         String
  description  String
  status       String    @default("draft") // 'draft' | 'active' | 'archived'
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  archivedAt   DateTime?

  versions      PlanVersion[]
  subscriptions Subscription[]
  planChanges   PlanChange[]

  @@index([status, displayOrder])
}

/// One immutable set of a plan's commercial terms. Append-only: database triggers refuse any UPDATE
/// or DELETE (migration plan_tables), and `Plan` cannot be deleted while a version points at it.
/// Amounts are integers in the currency's minor unit — 399900 is ₹3,999. A NULL price means the plan
/// is not sold on that cycle.
model PlanVersion {
  id           String   @id @default(cuid())
  planId       String
  /// 1 for the plan's first terms, then 2, 3, … The highest is what new subscriptions are sold.
  version      Int
  /// ISO 4217.
  currency     String
  monthlyPrice Int?
  annualPrice  Int?
  /// 0 when the plan has no trial.
  trialDays    Int      @default(0)
  /// How many `PlanFeature` / `PlanLimit` rows this version grants. Fixed with the version: a trigger
  /// refuses any grant beyond it, so an allowance cannot be added to after it is written. A version
  /// written before SAAS-002 declares 0 of each, and so grants nothing.
  featureCount Int      @default(0)
  limitCount   Int      @default(0)
  createdAt    DateTime @default(now())

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  features      PlanFeature[]
  limits        PlanLimit[]
  subscriptions Subscription[]
  changesTo     PlanChange[]   @relation("PlanChangeTo")
  changesFrom   PlanChange[]   @relation("PlanChangeFrom")

  @@unique([planId, version])
}

/// The feature catalogue (`packages/domain/src/entitlement.ts`), mirrored so that a grant is a foreign
/// key rather than free text. Written only by migrations; a test keeps it equal to the domain's.
model Feature {
  /// The catalogue key itself, e.g. `courses.manage`.
  id           String @id
  group        String
  label        String
  description  String
  displayOrder Int
  /// How the feature is delivered (SAAS-025): 'route' (routes refuse without it), 'service' (a service level no
  /// route checks), 'planned' (sold but not built yet).
  enforcement  String @default("route")

  grants PlanFeature[]
}

/// The limit catalogue, mirrored the same way.
model LimitDefinition {
  /// The catalogue key itself, e.g. `learners.max`.
  id           String @id
  label        String
  unit         String // 'count' | 'bytes'
  period       String // 'total' | 'month'
  displayOrder Int

  grants PlanLimit[]
}

/// A feature one plan version grants. Append-only, like the version (triggers).
model PlanFeature {
  planVersionId String
  featureKey    String

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  feature     Feature     @relation(fields: [featureKey], references: [id], onDelete: Restrict)

  @@id([planVersionId, featureKey])
  @@index([featureKey])
}

/// A limit one plan version sets. `value` is in the limit's unit (bytes for storage); NULL is
/// unlimited. A limit a version does not state grants nothing. Append-only (triggers).
model PlanLimit {
  planVersionId String
  limitKey      String
  value         BigInt?

  planVersion PlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  limit       LimitDefinition @relation(fields: [limitKey], references: [id], onDelete: Restrict)

  @@id([planVersionId, limitKey])
  @@index([limitKey])
}

// ─── Usage ───────────────────────────────────────────────────────────────

/// One row per academy and limit, written first by every transaction that would add to that limit
/// (SAAS-011, `lib/usage.ts`). The write takes the database's lock for the row — SQLite's single writer,
/// or a row lock on PostgreSQL — so the count and check that follow can never be raced by another
/// request for the same academy and limit. It holds no figure: usage is counted live.
model UsageGuard {
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  limitKey  String
  touchedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, limitKey])
}

// ─── Tax & billing profiles ──────────────────────────────────────────────

/// A tax the platform charges buyers in one country — or one region of it (subscriptions.md §27).
/// Platform-owned. Which tax applies to whom is this data, never a condition in code: a region's rule
/// wins over its country's, and a buyer with no rule pays none. Its components are fixed once written
/// (triggers); a rate change retires the rule and adds a new one, so an invoice's tax can always be
/// traced to the rule it used. One active rule per country and region.
model TaxRule {
  id             String    @id @default(cuid())
  name           String
  /// ISO 3166-1 alpha-2, e.g. `IN`.
  country        String
  /// A region code within the country (e.g. a state), or null for the whole country.
  region         String?
  /// Whether prices already include this tax.
  inclusive      Boolean   @default(false)
  /// How many components the rule declares; a trigger refuses any beyond it.
  componentCount Int
  createdAt      DateTime  @default(now())
  retiredAt      DateTime?

  components TaxRuleComponent[]

  @@index([country, region])
}

/// One tax a rule levies, at a rate in basis points (1800 is 18%). Never updated or deleted.
model TaxRuleComponent {
  ruleId   String
  code     String
  label    String
  rateBps  Int
  position Int

  rule TaxRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  @@id([ruleId, code])
}

/// Who an academy bills as, and where (§27): the address and tax registration its invoices carry and
/// its tax is decided by. Academy-owned, one per academy. Invoices copy what they print (SAAS-008),
/// so a later change of address rewrites no invoice.
model BillingProfile {
  id              String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId        String   @unique
  legalName       String
  email           String
  addressLine1    String
  addressLine2    String?
  city            String
  region          String?
  postalCode      String
  /// ISO 3166-1 alpha-2.
  country         String
  /// A tax registration such as a GSTIN or a VAT number, as issued. Not validated against any one country's format.
  taxRegistration String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// ─── Subscriptions ───────────────────────────────────────────────────────

/// An academy's subscription to a plan (subscriptions.md §5). Academy-owned. It holds the plan version
/// it was sold — never just the plan — so its price and allowance survive any later plan edit, and the
/// amount it is charged is copied from that version by the server, never taken from a request. Its
/// status changes only through a named transition in `lib/subscriptions.ts`: the database refuses a
/// status change the latest `SubscriptionEvent` does not describe, a status an academy cannot start in,
/// and any delete. At most one live (not cancelled, not expired) subscription per academy.
model Subscription {
  id                     String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId               String
  planId                 String
  planVersionId          String
  status                 String // 'trialing' | 'active' | 'past_due' | 'paused' | 'canceling' | 'canceled' | 'expired'
  billingCycle           String // 'monthly' | 'annual'
  /// ISO 4217, from the plan version.
  currency               String
  /// What each period is charged, in the currency's minor unit, from the plan version.
  amount                 Int
  trialStartAt           DateTime?
  trialEndAt             DateTime?
  currentPeriodStartAt   DateTime
  currentPeriodEndAt     DateTime
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelRequestedAt      DateTime?
  canceledAt             DateTime?
  cancellationReason     String?
  pausedAt               DateTime?
  resumesAt              DateTime?
  /// When the current overdue episode began, and why (the provider's failure reason).
  pastDueAt              DateTime?
  pastDueReason          String?
  /// The grace window after payment retries are exhausted: set only by grace_started (triggers).
  gracePeriodStartAt     DateTime?
  gracePeriodEndAt       DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  /// The paid first-purchase invoice this subscription was created from (self-service checkout), once per
  /// invoice (unique). Null for a subscription the platform started. Checked by Subscription_from_invoice.
  sourceInvoiceId        String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan        Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion PlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  events      SubscriptionEvent[]
  planChanges PlanChange[]
  invoices    Invoice[]
  payments    Payment[]

  @@unique([provider, providerSubscriptionId])
  @@index([tenantId, status])
  @@index([planVersionId])
  @@index([status, currentPeriodEndAt])
}

/// A requested change of plan (SAAS-006; D7–D10). Academy-owned. An upgrade is a quote — its credit and
/// charge fixed when issued — that waits in `pending_payment` for a confirmed provider payment; a
/// downgrade is `scheduled` for the period boundary. Every figure is an integer of paise and is never
/// updated (triggers); only the status moves, along the allowed paths. At most one open change per
/// subscription. Never deleted.
model PlanChange {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  subscriptionId    String
  kind              String // 'upgrade' | 'cycle_upgrade' | 'downgrade' | 'scheduled_change'
  status            String // 'pending_payment' | 'scheduled' | 'applied' | 'canceled' | 'void' | 'expired'
  fromPlanVersionId String
  fromCycle         String
  fromAmount        Int
  toPlanId          String
  toPlanVersionId   String
  toCycle           String
  toAmount          Int
  currency          String
  /// The unused value of the current period credited (immediate changes; 0 otherwise).
  credit            Int       @default(0)
  /// What must be paid before the change applies (immediate changes; 0 otherwise).
  charge            Int       @default(0)
  /// Credit a cycle change could not use — recorded, never paid out.
  forfeited         Int       @default(0)
  /// The period the quote was priced against.
  periodStartAt     DateTime
  periodEndAt       DateTime
  quotedAt          DateTime
  /// Limits the academy already exceeds on the new plan, as JSON — shown to the tenant, nothing deleted.
  conflictsJson     String    @default("[]")
  requestedById     String?
  appliedAt         DateTime?
  closedAt          DateTime?
  closedReason      String?
  createdAt         DateTime  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  toPlan       Plan         @relation(fields: [toPlanId], references: [id], onDelete: Restrict)
  toVersion    PlanVersion  @relation("PlanChangeTo", fields: [toPlanVersionId], references: [id], onDelete: Restrict)
  fromVersion  PlanVersion  @relation("PlanChangeFrom", fields: [fromPlanVersionId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([tenantId, createdAt])
  @@index([subscriptionId, status])
}

/// The lifecycle log (§19): one row per transition, written in the same transaction as the status it
/// records. Append-only — triggers refuse any UPDATE or DELETE. `id` orders the log; the latest row is
/// what the database checks a status change against.
model SubscriptionEvent {
  id             Int      @id @default(autoincrement())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId       String
  subscriptionId String
  /// e.g. `subscription.created`, `subscription.payment.failed`.
  event          String
  /// The named transition, or `create` for the first row.
  transition     String
  fromStatus     String?
  toStatus       String
  actorType      String // 'user' | 'system' | 'provider'
  /// The account, when a person did it.
  actorId        String?
  /// The job or provider, when a person did not; the provider's event reference goes in meta.
  source         String?
  metaJson       String   @default("{}")
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([subscriptionId, id])
}

// ─── Invoices & payments ─────────────────────────────────────────────────

/// Hands out invoice numbers, one series per calendar year (`INV-2026` → INV-2026-000001, …).
/// Platform-owned; the counter only ever goes up, and `Invoice.number` is unique besides.
model InvoiceSequence {
  series String @id
  next   Int
}

/// An invoice (subscriptions.md §15). Academy-owned. Issued from the server's payable amount
/// (`lib/billing.ts`), with its lines, tax lines and the billing address it was sent to fixed at issue:
/// nothing a later plan edit, price change or address change does can rewrite it (triggers). Only its
/// status moves — open → paid (with a paid payment for its total) or open → void. Never deleted.
model Invoice {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  number            String    @unique
  purpose           String // 'new_subscription' | 'renewal' | 'plan_change'
  status            String // 'open' | 'paid' | 'void'
  subscriptionId    String?
  planChangeId      String?
  currency          String
  /// Minor units. `total = subtotal + taxTotal` always (CHECK); for a tax-inclusive price the subtotal is the net.
  subtotal          Int
  taxTotal          Int
  total             Int
  inclusive         Boolean
  taxRuleId         String?
  linesJson         String
  taxLinesJson      String
  /// The billing profile as it stood at issue.
  billedToJson      String
  periodStartAt     DateTime?
  periodEndAt       DateTime?
  issuedAt          DateTime
  dueAt             DateTime
  paidAt            DateTime?
  voidedAt          DateTime?
  voidReason        String?
  provider          String?
  providerInvoiceId String?
  createdAt         DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscription  Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  planChange    PlanChange?    @relation(fields: [planChangeId], references: [id], onDelete: Restrict)
  /// First purchase only (purpose `new_subscription`): the plan version and cycle it sells, fixed at issue.
  /// The subscription created when it is paid gets exactly these (triggers Invoice_sale_*).
  planVersionId String?
  billingCycle  String?
  payments      Payment[]
  orders        PaymentOrder[]

  @@unique([provider, providerInvoiceId])
  @@index([tenantId, issuedAt])
  @@index([subscriptionId])
  @@index([status])
}

/// A payment (§14). Academy-owned and immutable once settled: it is written `pending`, `paid` or
/// `failed`, a pending one settles once, and a paid or failed one is never updated or deleted
/// (triggers). A refund is a Refund row beside it — the payment itself is never rewritten to say so;
/// "refunded" / "partially refunded" are read from its refunds. The payment method is masked display
/// data only; no card number exists anywhere.
model Payment {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  invoiceId         String?
  subscriptionId    String?
  provider          String
  providerPaymentId String
  amount            Int
  currency          String
  status            String // 'pending' | 'paid' | 'failed'
  failureCode       String?
  failureMessage    String?
  methodKind        String?
  methodBrand       String?
  methodLast4       String?
  paidAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  refunds      Refund[]

  @@unique([provider, providerPaymentId])
  @@index([tenantId, createdAt])
  @@index([invoiceId])
}

/// A checkout (§43; SAAS-009): the provider order an open invoice is paid through. Its amount and currency
/// are the invoice's, fixed when the order is made — the browser never names one — and the database checks
/// both against the invoice (trigger PaymentOrder_matches_invoice). It settles once, when a payment the
/// provider itself reports as captured is recorded against it; it is never deleted.
model PaymentOrder {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  invoiceId         String
  provider          String
  providerOrderId   String
  amount            Int
  currency          String
  status            String    @default("created") // 'created' | 'paid'
  /// The provider payment that settled it.
  providerPaymentId String?
  /// `test` or `live`: the gateway credentials the order was created with, and the only ones that may confirm,
  /// reconcile or refund it (SAAS-017). Null for an order made before gateways had environments.
  environment       String?
  createdAt         DateTime  @default(now())
  paidAt            DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([provider, providerOrderId])
  @@index([invoiceId])
  @@index([tenantId, createdAt])
}

/// A provider webhook as it was received (§17, §18; SAAS-010) — the platform's receipt, and its idempotency
/// key: one row per provider event, unique on (provider, providerEventId), so a redelivered event repeats no
/// side effect. Only a signed webhook is ever stored. The body is not kept — it carries the payer's contact
/// details — only its SHA-256 and the ids processing needs. Never deleted; see trigger WebhookEvent_receipt.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  eventType       String
  /// SHA-256 of the exact signed body, hex. A replay of the same body under another event id is caught by it.
  payloadHash     String
  /// The ids the event names (payment, order, refund) and its reported status, as JSON — never contact or card data.
  referenceJson   String    @default("{}")
  status          String    @default("received") // 'received' | 'processed' | 'ignored' | 'failed'
  attempts        Int       @default(1)
  /// Why the last attempt failed, or why the event was ignored — our words, redacted.
  note            String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([provider, payloadHash])
  @@index([status, receivedAt])
}

/// A payment gateway the platform can take payments through (SAAS-017; decision D11). One row per provider.
/// Platform-owned: gateways are configured by the Super Admin, not by an academy. Credentials are stored only
/// encrypted (AES-256-GCM, `lib/credentialVault.ts`) under a key that is a deployment secret and never in the
/// database; `credentialHint` holds only what is safe to show (a public key id, masked). At most one gateway
/// is active, and only an enabled, configured one (index PaymentGatewayConfig_one_active, trigger
/// PaymentGatewayConfig_active_valid). Switching the active gateway affects only new payments.
model PaymentGatewayConfig {
  id          String   @id @default(cuid())
  /// The provider id from the gateway registry: `razorpay`, `vyapargateway`.
  provider    String   @unique
  enabled     Boolean  @default(false)
  isActive    Boolean  @default(false)
  /// `test` or `live`: whose credentials new payments through this gateway use. The active gateway's
  /// environment must have credentials (trigger PaymentGatewayConfig_active_ready).
  environment String   @default("test")
  /// Bumped on every change, so a cached adapter is rebuilt.
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

/// A gateway's credentials for one environment (SAAS-017): test and live are kept apart, so a test key can
/// never serve a live payment. Encrypted with AES-256-GCM under PAYMENT_CREDENTIALS_KEY; replaced in place,
/// never deleted.
model PaymentGatewayCredential {
  id           String   @id @default(cuid())
  provider     String
  /// `test` or `live`.
  environment  String
  /// The encrypted credentials.
  cipher       String
  /// Which encryption key sealed them — a fingerprint, never the key.
  keyId        String
  /// Safe to show: e.g. {"hint":{"keyId":"rzp_test_…AbCd"},"secretsSet":["keySecret"]}. Never a secret.
  hint         String   @default("{}")
  configuredAt DateTime @default(now())
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([provider, environment])
}

/// A refund (§29): a separate financial event against a paid payment, full or partial. The refunds of a
/// payment can never add up to more than it (trigger), and the payment row is never touched. Pending
/// until the provider settles it; never deleted.
model Refund {
  id               String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId         String
  paymentId        String
  amount           Int
  currency         String
  reason           String
  status           String // 'pending' | 'succeeded' | 'failed'
  provider         String
  providerRefundId String?
  requestedById    String?
  failureMessage   String?
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([tenantId, createdAt])
  @@index([paymentId])
}

/// A saved way to pay (§16): the provider's reference and what is safe to print — "Visa •••• 4242",
/// "UPI". There is no column a card number, expiry-with-number or security code could go in; `last4`
/// is exactly four digits (CHECK). Removed, never deleted.
model PaymentMethod {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  provider          String
  providerMethodRef String
  kind              String // 'card' | 'upi' | 'netbanking' | 'mandate' | 'invoice'
  brand             String
  last4             String?
  expMonth          Int?
  expYear           Int?
  isDefault         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  removedAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([provider, providerMethodRef])
  @@index([tenantId])
}

// ─── Identity ────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId         String?
  email            String    @unique
  /// Mobile number given at registration; not unique, the email identifies the account.
  phone            String?
  passwordHash     String
  name             String
  role             String // 'student' | 'instructor' | 'admin' | 'superadmin'
  descriptor       String    @default("")
  instructorId     String?
  /// Set when a super admin deactivates the account; null means active. Only academy admins are
  /// deactivated today (`/superadmin/admins/:id/deactivate`) — a learner is suspended through
  /// `Student.suspended` and an instructor through `Instructor.status`, both unchanged.
  deactivatedAt    DateTime?
  /// Tokens that carry no session id and were issued before this instant are refused (SAAS-020): set by
  /// logout-all, a password change and a password reset, so tokens from before sessions existed end too.
  tokensValidAfter DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  student        Student?
  instructor     Instructor?           @relation(fields: [instructorId], references: [id])
  notifications  AppNotification[]
  notifSettings  NotificationSettings?
  calendarEvents CalendarEvent[]       @relation("CalendarOwner")
  resetTokens    PasswordResetToken[]
  sessions       UserSession[]
  devices        DeviceToken[]
  auditEvents    AuditLog[]
  permissions    AdminPermission[]
  ownedTenants   Tenant[]              @relation("TenantOwner")
  affiliate      Affiliate?

  tenant Tenant? @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([instructorId])
  @@index([tenantId])
}

/// Forgot-password links. Only the SHA-256 hash of the token is stored; a token is single use.
/// A device registered for push notifications (SAAS-021), bound to the session that registered it: ending the
/// session removes it. A token belongs to one account at a time — registering it again moves it.
model DeviceToken {
  id         String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId   String?
  userId     String
  sessionId  String?
  /// 'android' | 'ios' | 'web'
  platform   String
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId])
  @@index([tenantId])
}

/// One push hint for one in-app notification (SAAS-021): at most one per notification, retried with backoff,
/// held until the recipient's quiet hours end. The payload is only the notification's id and category.
model PushDelivery {
  id             String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId       String?
  userId         String
  notificationId String    @unique
  /// 'queued' | 'sending' | 'sent' | 'failed' | 'skipped'
  status         String    @default("queued")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  /// Devices reached, and the last failure in plain words (never a provider secret).
  delivered      Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

/// A signed-in session (SAAS-020). Its id travels in the token as `sid`; the per-request account read checks it,
/// so revoking the row ends that token on the next request. Never deleted by the app except when long expired.
model UserSession {
  id            String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId      String?
  userId        String
  createdAt     DateTime  @default(now())
  /// When the token issued with it expires.
  expiresAt     DateTime
  revokedAt     DateTime?
  /// 'logout' | 'logout-all' | 'revoked' | 'password-changed' | 'password-reset'
  revokedReason String?
  /// The client that signed in, as it described itself (truncated). Shown in the session list; never trusted.
  userAgent     String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId  String?
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([tenantId])
}

/// A self-serve registration waiting for its email to be verified (SAAS-026). Platform-owned: no academy
/// exists until the code is confirmed, and then `lib/signup.ts` provisions one and records its id here.
/// The password and the code are stored only as hashes; a row is never a sign-in.
model PendingSignup {
  id               String    @id @default(cuid())
  email            String
  adminName        String
  academyName      String
  slug             String
  passwordHash     String
  /// HMAC of the 6-digit code under the server secret, bound to this row's id.
  codeHash         String
  attempts         Int       @default(0)
  expiresAt        DateTime
  lastSentAt       DateTime
  /// Codes sent for this registration, the first included — capped, so one registration cannot flood an address.
  sendCount        Int       @default(1)
  /// Set once, when the code is confirmed; a consumed row can never be confirmed again.
  consumedAt       DateTime?
  /// The plan and cycle chosen before registering, kept so the choice survives a refresh and the first sign-in.
  planId           String?
  cycle            String?
  /// The academy the confirmed signup created.
  createdAcademyId String?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

/// A learner or instructor who registered themselves, waiting for their email to be verified. Academy-owned: the
/// academy is the one the link named (a join link, an invitation or a course link), fixed when the row is made and never
/// taken from a request body. Nothing that can sign in exists until the code is confirmed; then `lib/pendingAccounts.ts`
/// creates the account through the same path an unverified registration used. The password and the code are hashes.
model PendingAccount {
  id            String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId      String
  /// 'student' | 'instructor' — fixed by the door it came through, never by the request.
  role          String
  email         String
  name          String
  /// An instructor's title, when they gave one.
  title         String?
  passwordHash  String
  /// HMAC of the 6-digit code under the server secret, bound to this row's id (lib/verificationCode.ts).
  codeHash      String
  attempts      Int       @default(0)
  sendCount     Int       @default(1)
  expiresAt     DateTime
  lastSentAt    DateTime
  /// Set once, when the code is confirmed; a consumed row can never be confirmed again.
  consumedAt    DateTime?
  /// The invitation or course link the registration came through; checked again when the account is created.
  invitationId  String?
  courseId      String?
  createdUserId String?
  /// The registrant's mobile number, and an instructor's application (JSON: bio, expertise, yearsTeaching, links).
  phone         String?
  profileJson   String?
  /// The affiliate program referral the registrant arrived with (MLM-001), carried to the account when the code is confirmed.
  referralCode  String?
  preferredLeg  String?
  /// The leg the sponsor's link named, which is not the registrant's own preference.
  requestedLeg  String?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, email])
  @@index([email])
  @@index([expiresAt])
}

/// A request to the platform team (SAAS-027, SAAS-029): a demo, sales or support request from the company website
/// (no academy — `tenantId` null), or a support request an academy's admin raises from their workspace (their
/// academy, from the server context). The Super Admin's inbox lists both. A request is never deleted.
model Inquiry {
  id           String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null for a website visitor's request.
  tenantId     String?
  /// `demo` · `sales` · `support`
  kind         String
  /// `new` · `in_progress` · `closed`
  status       String    @default("new")
  name         String
  email        String
  organisation String?
  phone        String?
  /// What the visitor said they need, e.g. the learners they expect.
  size         String?
  subject      String?
  message      String
  /// The signed-in admin who raised it, for an academy's request.
  userId       String?
  /// The platform team's private note on how it was handled.
  note         String?
  handledById  String?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([status, createdAt])
}

/// One permission an academy admin holds. Keys live in `packages/domain` (`PermissionKey`) — this
/// table stores only who holds which. Grants exist for the `admin` role alone: instructors keep
/// role-and-scope authorization, and a super admin's reach comes from its own router, not from here.
model AdminPermission {
  id        String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  userId    String
  key       String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@index([userId])
  @@index([tenantId])
}

/// Platform audit trail. Written by Super Admin operations through `lib/audit.ts`, never by the
/// academy's own routes, and read back at `GET /superadmin/audit`. The actor's email is kept
/// alongside the reference so the trail still names who acted after an account is removed.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  /// Who did it (§36): `user` (a person — actorId/actorEmail/actorRole), `system` (a scheduled job) or `provider` (the payment provider). Checked by trigger AuditLog_actor_shape.
  actorType  String   @default("user")
  /// The job or provider a `system` or `provider` event names; null for a person.
  source     String?
  action     String
  targetType String
  targetId   String?
  /// Extra context for the event, as JSON text (the schema's convention for shaped values).
  metaJson   String   @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

/// Outgoing email queue. Rows are written by the API; a transport (log/SMTP) drains them.
model EmailOutbox {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts. Null only for platform-level rows (a super admin and what belongs to one).
  tenantId          String?
  toEmail           String
  toName            String?
  subject           String
  text              String
  templateKey       String
  status            String    @default("queued") // 'queued' | 'sending' | 'sent' | 'failed'
  error             String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  /// Delivery (SAAS-021): attempts made, when the next may run, when the last began.
  attempts          Int       @default(0)
  nextAttemptAt     DateTime?
  lastAttemptAt     DateTime?
  /// The same message to the same address within the dedup window is not queued twice.
  dedupKey          String?
  /// The transport's reference for the sent message, when it gives one.
  providerMessageId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([dedupKey])
  @@index([toEmail])
  @@index([tenantId])
}

/// An uploaded file (lesson video/document, assignment attachment). Stored on disk under UPLOAD_DIR with a random name.
model MediaAsset {
  id           String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId     String
  ownerUserId  String
  kind         String // 'video' | 'document' | 'image'
  originalName String
  mime         String
  sizeBytes    Int
  storageName  String   @unique
  createdAt    DateTime @default(now())

  /// Courses showing this image as their cover.
  coverOf Course[] @relation("CourseCoverImage")
  /// Set when the Super Admin placed this image on the public website: only such images are served without a session.
  siteImage SiteImage?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  @@index([tenantId])
}

// ─── Catalog ─────────────────────────────────────────────────────────────

model Level {
  id       String  @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId String
  name     String
  order    Int
  summary  String?

  courses    Course[]
  categories CategoryLevel[]
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Category {
  id          String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String
  name        String
  description String
  order       Int
  status      String // 'active' | 'hidden'
  glyph       String
  updatedAt   DateTime @updatedAt

  courses Course[]
  levels  CategoryLevel[]
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// Categories may span several levels — many-to-many join.
model CategoryLevel {
  categoryId String
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId   String
  levelId    String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  level      Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([categoryId, levelId])
  @@index([tenantId])
}

model Instructor {
  id            String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId      String
  name          String
  title         String
  yearsTeaching Int?
  email         String   @unique
  bio           String   @default("")
  expertiseJson String   @default("[]")
  status        String // 'active' | 'invited' | 'inactive'
  joinedAt      DateTime @default(now())
  city          String   @default("")
  languagesJson String   @default("[]")
  phone         String?
  photoJson     String?
  /// Links an applicant gave: a portfolio, a profile (docs/16 §2.5).
  linksJson     String   @default("[]")

  users        User[]
  courses      CourseInstructor[]
  liveClasses  LiveClass[]
  calendarOwns CalendarEvent[]    @relation("CalendarInstructor")
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

model Course {
  id                    String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId              String
  slug                  String
  title                 String
  subtitle              String    @default("")
  description           String    @default("")
  levelId               String
  categoryId            String
  format                String
  language              String    @default("en-IN")
  coverMotif            String
  liveSessions          Int       @default(0)
  estimatedWeeks        Int?
  certificateTitle      String?
  /// Whole rupees, all-inclusive (what the learner pays). Read with `pricing`: only a `paid` course charges it.
  priceAmount           Int?
  priceCurrency         String    @default("INR")
  /// `free` | `paid` | `unset`. `unset` is a course whose price was never chosen by an admin (it was filled from the
  /// academy default before pricing existed): nobody can enrol themselves or buy it until an admin chooses.
  /// A lower price the course sells at now, in whole rupees; null for none. Always below priceAmount.
  salePrice             Int?
  pricing               String    @default("unset")
  enrolledCount         Int       @default(0)
  status                String    @default("draft") // 'draft' | 'published' | 'archived'
  visibility            String    @default("public")
  outcomesJson          String    @default("[]")
  tagsJson              String    @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  publishedAt           DateTime?
  rating                Float?
  ratingCount           Int?
  certificateTemplateId String?
  /// An uploaded cover image (a staff-uploaded `MediaAsset` of kind image). Null draws `coverMotif` instead.
  coverImageId          String?

  level               Level                @relation(fields: [levelId], references: [id])
  category            Category             @relation(fields: [categoryId], references: [id])
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  instructors         CourseInstructor[]
  chapters            Chapter[]
  enrollments         Enrollment[]
  quizzes             Quiz[]
  assignments         CourseAssignment[]
  liveClasses         LiveClass[]
  calendar            CalendarEvent[]
  issuedCertificates  IssuedCertificate[]
  purchases           CoursePurchase[]
  coupons             Coupon[]
  bundleLinks         CourseBundleCourse[]
  reviews             CourseReview[]
  coverImage         MediaAsset?          @relation("CourseCoverImage", fields: [coverImageId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])
  @@index([categoryId])
  @@index([coverImageId])
  @@index([levelId])
  @@index([status])
}

model CourseInstructor {
  courseId     String
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId     String
  instructorId String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([courseId, instructorId])
  @@index([tenantId])
}

model Chapter {
  id           String  @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId     String
  courseId     String
  title        String
  summary      String?
  objective    String?
  estimatedMin Int?
  status       String  @default("draft")
  position     Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([tenantId])
}

model Lesson {
  id             String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId       String
  chapterId      String
  courseId       String
  title          String
  type           String // LessonType
  durationMin    Int      @default(0)
  isPreview      Boolean  @default(false)
  status         String   @default("draft")
  updatedAt      DateTime @updatedAt
  description    String?
  objectivesJson String   @default("[]")
  contentJson    String   @default("{}")
  settingsJson   String   @default("{}")
  position       Int

  chapter    Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress   LessonProgress[]
  notes      LessonNote[]
  bookmarks  LessonBookmark[]
  quiz       Quiz?
  assignment CourseAssignment?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([chapterId])
  @@index([courseId])
  @@index([tenantId])
}

// ─── People ──────────────────────────────────────────────────────────────

model Student {
  id            String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId      String
  userId        String    @unique
  phone         String?
  city          String    @default("")
  joinedAt      DateTime  @default(now())
  lastActiveAt  DateTime  @default(now())
  suspended     Boolean   @default(false)
  suspendReason String?
  rankId        String?
  /// Last inactivity nudge, so a quiet learner is nudged at most once a week.
  nudgedAt      DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank         Rank?               @relation(fields: [rankId], references: [id])
  enrollments  Enrollment[]
  progress     LessonProgress[]
  notes        LessonNote[]
  bookmarks    LessonBookmark[]
  savedCourses SavedCourse[]
  quizAttempts QuizAttempt[]
  quizSessions QuizSession[]
  submissions  Submission[]
  liveRegs     LiveRegistration[]
  certificates IssuedCertificate[]
  purchases    CoursePurchase[]
  bundlePurchases BundlePurchase[]
  drafts       AssignmentDraft[]
  affiliate    Affiliate?
  reviews      CourseReview[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([rankId])
  @@index([tenantId])
}

model Enrollment {
  id           String          @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId     String
  studentId    String
  courseId     String
  enrolledAt   DateTime        @default(now())
  status       String          @default("active") // EnrollmentStatus
  progress     Int             @default(0)
  source       String          @default("self")
  lastActiveAt DateTime?
  completedAt  DateTime?
  expiresAt    DateTime?
  lastLessonId String?
  /// The verified purchase that opened a paid course (source `purchase`); null for every other way in.
  purchaseId   String?         @unique
  purchase     CoursePurchase? @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([tenantId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId       String
  studentId      String
  lessonId       String
  state          String    @default("not-started") // ProgressState
  fraction       Float?
  positionSec    Int?
  completedAt    DateTime?
  lastAccessedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([studentId, lessonId])
  @@index([lessonId])
  @@index([tenantId])
}

model LessonNote {
  studentId String
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  lessonId  String
  text      String   @default("")
  savedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([studentId, lessonId])
  @@index([tenantId])
}

model LessonBookmark {
  studentId String
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  lessonId  String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([studentId, lessonId])
  @@index([tenantId])
}

/// One learner's review of one course (docs/16, D-PLAT-11). `Course.rating` and `ratingCount` are recomputed from the
/// published rows in the same transaction as any change here.
model CourseReview {
  id        String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  studentId String
  courseId  String
  /// 1 to 5, checked by the database.
  rating    Int
  /// Plain text, at most 2000 characters, checked by the database.
  comment   String   @default("")
  /// `published` | `hidden`, checked by the database. A learner's edit never changes it.
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([tenantId])
}

model SavedCourse {
  studentId String
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId  String
  courseId  String
  savedAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

