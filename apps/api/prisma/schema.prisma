// ─── Platform branding ───────────────────────────────────────────────────

/// A logo or favicon the Super Admin uploaded for the platform itself: the ZuviloAI website, its sign-in
/// screens and the workspace chrome. At most one row per kind; no row means the built-in ZuviloAI asset, which
/// every client carries. Platform-owned: an academy's own appearance lives in `Settings` and never reaches here.
/// The file is on disk under UPLOAD_DIR/branding with a name the server chose, new for every upload.
model PlatformBrandAsset {
  /// `logo` or `favicon`.
  kind         String   @id
  storageName  String   @unique
  /// The uploaded file's name, cleaned — shown to the Super Admin, never used on disk.
  originalName String
  mime         String
  sizeBytes    Int
  width        Int
  height       Int
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

