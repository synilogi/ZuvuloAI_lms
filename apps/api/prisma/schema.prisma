  instructions  String   @default("")
  status        String   @default("draft")
  questionsJson String   @default("[]")
  settingsJson  String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?       @relation(fields: [lessonId], references: [id])
  attempts QuizAttempt[]
  sessions QuizSession[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([courseId])
  @@index([tenantId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String
  quizId      String
  studentId   String
  answersJson String   @default("{}")
  resultJson  String   @default("{}")
  percent     Int      @default(0)
  passed      Boolean  @default(false)
  durationSec Int?
  createdAt   DateTime @default(now())
  /// The session this attempt finished (A2). Null for attempts made before sessions existed.
  sessionId   String?  @unique

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session QuizSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([quizId])
  @@index([studentId])
  @@index([tenantId])
}

/// A learner's attempt at a quiz from the moment the server starts it (A2, packages/domain/src/quizSession.ts).
/// Starting consumes an attempt. The deadline is the server's; the answers are those it accepted before the
/// deadline. Finishing — submitted by the learner, or expired and closed by the server — writes the QuizAttempt.
model QuizSession {
  id             String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId       String
  quizId         String
  studentId      String
  /// 1 for the learner's first attempt at the quiz, counting attempts made before sessions existed.
  attemptNo      Int
  status         String    @default("active") // QuizSessionStatus: active | submitted | expired
  startedAt      DateTime  @default(now())
  /// Null for an untimed quiz.
  deadlineAt     DateTime?
  /// The questions as they stood when the attempt started, with their key: scoring reads these, never the client.
  questionsJson  String
  /// The quiz's settings as they stood when the attempt started — its pass mark among them — so editing the quiz
  /// while the attempt is open changes nothing about how it is scored.
  settingsJson   String    @default("{}")
  /// The question and option order this learner was shown (QuizOrder).
  orderJson      String    @default("{}")
  answersJson    String    @default("{}")
  /// The highest save number accepted, so a save that arrives late cannot overwrite a newer one.
  answersSeq     Int       @default(0)
  answersSavedAt DateTime?
  /// The client's key for the start request: a retried start answers with the same session.
  startKey       String?
  finishedAt     DateTime?
  updatedAt      DateTime  @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt QuizAttempt?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([quizId, studentId, attemptNo])
  @@index([studentId, quizId])
  @@index([status, deadlineAt])
  @@index([tenantId])
}

