model HelpCategory {
  id          String @id @default(cuid())
  name        String
  description String
  icon        String
  order       Int

  articles HelpArticle[]
}

model HelpArticle {
  id          String   @id @default(cuid())
  slug        String   @unique
  categoryId  String
  title       String
  summary     String
  body        String
  audience    String   @default("all")
  tagsJson    String   @default("[]")
