/// Who is running a scheduled job right now (SAAS-022). A process takes the lease before running the job and
/// gives it back after; a lease whose holder died expires and is taken over. The platform's own table.
model JobLease {
  job         String    @id
  /// `host:pid:boot` of the process holding it.
  holder      String
  acquiredAt  DateTime
  expiresAt   DateTime
  lastRunAt   DateTime?
  /// 'ok' | 'failed' — of the last run that finished.
  lastOutcome String?
  lastHolder  String?
}

/// An Admin's invitation for one learner to join their LMS (`/invite/<token>`). The link is the credential: only
/// the SHA-256 of its token is stored. It is scoped to its Admin's workspace (`tenantId`) and role, expires, and is
/// used once — the account it creates or signs in belongs to that workspace, whatever the client sends.
model Invitation {
  id           String    @id @default(cuid())
  /// The Admin workspace this invitation joins — see lib/tenancy.ts.
  tenantId     String
  /// Only 'student' today; staff are invited through their pre-created account (Instructors module).
  role         String    @default("student")
  tokenHash    String    @unique
  /// When set, only this address may accept.
  email        String?
  createdById  String?
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

/// An academy's own online payments for course sales: which gateway, which environment, and whether it is on. The money
/// a learner pays settles to the academy's account, never the platform's. One row per academy.
model AcademyPaymentConfig {
  id          String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String   @unique
  /// `razorpay`: the only gateway implemented for course sales.
  provider    String   @default("razorpay")
  /// `test` or `live`: whose credentials new purchases use. A production process refuses `test` for new purchases.
  environment String   @default("test")
  enabled     Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

/// An academy's gateway credentials for one environment, encrypted under PAYMENT_CREDENTIALS_KEY like the platform's.
/// Test and live are kept apart; replaced in place, never returned or logged.
model AcademyGatewayCredential {
  id          String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String
  provider    String
  environment String
  cipher      String
  keyId       String
  /// Safe to show: the masked key id. Never a secret.
  hint        String   @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, environment])
  @@index([tenantId])
}

/// A learner's purchase of a paid course: one gateway order, priced by the server. `created` until the gateway
/// confirms; `paid` opens the enrolment (once); `failed` and `expired` open nothing. Amount, currency, learner,
/// course and order never change once written (trigger).
model CoursePurchase {
  id                String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId          String
  studentId         String
  courseId          String
  /// The charge in minor units (paise), from the course's price when the order was made.
  amount            Int
  currency          String    @default("INR")
  /// The course price shown to the learner, in whole rupees, kept for the receipt.
  listPrice         Int
  provider          String
  environment       String
  providerOrderId   String
  providerPaymentId String?
  /// `created` | `paid` | `failed` | `expired`.
  status            String    @default("created")
  failureCode       String?
  failureMessage    String?
  /// Money the gateway took that opens nothing (a second payment for a course the learner already has, or a course
  /// no longer for sale): recorded and flagged for the academy, never refunded automatically.
  reviewReason      String?
  /// `ORD-YYYY-NNNNNN`, from OrderSequence: what a learner and a receipt call this order (docs/16 §2.4). Fixed by trigger.
  orderNumber       String?   @unique
  /// What a coupon took off `amount`, in paise; `amount` is what was charged. Fixed by trigger.
  discountAmount    Int       @default(0)
  couponId          String?
  couponCode        String?
  /// Set when a refund of the whole order settled. `status` stays `paid`: the money was taken, and that stays true.
  refundedAt        DateTime?
  /// The gateway reported a lost dispute (docs/15 §6.8).
  chargebackAt      DateTime?
  /// This course's share of a bundle order (lib/bundlePurchases.ts). The gateway's order and payment are on the bundle; this row has provider `bundle` and earns no CV.
  bundlePurchaseId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  paidAt            DateTime?
  /// After this an unpaid order is not reused for a new checkout; a payment that still arrives is recorded.
  expiresAt         DateTime

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student    Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Course                 @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollment Enrollment?
  mlmOrder   MlmOrder?
  refunds    CoursePurchaseRefund[]
  redemption CouponRedemption?
  bundlePurchase BundlePurchase? @relation(fields: [bundlePurchaseId], references: [id], onDelete: Restrict)

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([tenantId])
  @@index([studentId, courseId])
  @@index([courseId])
  @@index([status, createdAt])
  @@index([bundlePurchaseId])
}

/// A course-payment webhook already received: one row per (academy, provider, event id), so a redelivery or a replay
/// changes nothing.
model CoursePaymentEvent {
  id          String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, provider, eventId])
  @@index([tenantId])
}

// ─── Affiliate program (MLM-000) ──────────────────────────────────────────

/// One version of the affiliate program's plan (docs/15 §4.2): every compensation term as data. Platform-owned; the
/// academy whose learners are the affiliates is `programTenantId`. At most one version is `active` (trigger); terms,
/// ranks and cap bands are sealed once a version leaves draft (triggers), so what a commission names is what it was
/// computed under. Amounts are 64-bit integers in minor units: group CV targets reach ₹500 crore.
model MlmPlanVersion {
  id                     String    @id @default(cuid())
  version                Int       @unique
  status                 String    @default("draft") // 'draft' | 'active' | 'retired'
  programTenantId        String
  eligibleCourseIdsJson  String    @default("[]")
  currency               String    @default("INR")
  cvBasisPoints          Int       @default(10000)
  matchingRateBps        Int       @default(1000)
  payoutCeilingBps       Int       @default(2500)
  normalPayoutBps        Int       @default(1500)
  matchingRunHourIst     Int       @default(2)
  cvEligibilityDelayDays Int       @default(0)
  capOverflowPolicy      String    @default("flush") // 'flush' | 'carry'
  carryForwardPolicy     String    @default("indefinite") // 'indefinite' | 'expire-days'
  carryExpiryDays        Int?
  spilloverRule          String    @default("extreme-outer") // 'extreme-outer' | 'breadth-first'
  withdrawalMinAmount    BigInt    @default(0)
  withdrawalRequiresKyc  Boolean   @default(true)
  tdsBps                 Int       @default(0)
  liabilityPeriod        String    @default("month")
  note                   String    @default("")
  createdAt              DateTime  @default(now())
  activatedAt            DateTime?
  retiredAt              DateTime?

  programTenant Tenant        @relation(fields: [programTenantId], references: [id], onDelete: Restrict)
  tiers         MlmRankTier[]
  capBands      MlmCapBand[]
  orders        MlmOrder[]

  @@index([status])
  @@index([programTenantId])
}

/// A daily matching cap band of a version; ranks point at one by key.
model MlmCapBand {
  id            String @id @default(cuid())
  planVersionId String
  key           String
  label         String
  dailyCap      BigInt
  order         Int

  planVersion MlmPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, key])
  @@unique([planVersionId, order])
}

/// One of a version's rank tiers, in ascending order of group CV; half of `groupCv` must come from each leg.
model MlmRankTier {
  id              String  @id @default(cuid())
  planVersionId   String
  order           Int
  name            String
  groupCv         BigInt
  rewardKind      String // 'recognition' | 'certificate' | 'cash'
  rewardAmount    BigInt  @default(0)
  rewardCapAmount BigInt?
  capBandKey      String
  vestingDays     Int     @default(0)

  planVersion MlmPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, order])
  @@unique([planVersionId, name])
}

/// A learner of the program academy in the affiliate program (MLM-001, docs/15 §4.3). Academy-owned. The sponsor (who
/// referred them) and the binary placement (where they sit) are separate relations; placement is written by the
/// genealogy module (MLM-002). `code` is the referral credential on every link, unique across the platform. Never
/// deleted (trigger); termination is final (trigger); sponsor and parent must be in the same academy (trigger).
model Affiliate {
  id                   String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId             String
  userId               String    @unique
  studentId            String    @unique
  code                 String    @unique
  status               String    @default("pending") // 'pending' | 'active' | 'suspended' | 'terminated'
  sponsorId            String?
  placementParentId    String?
  placementLeg         String? // 'A' | 'B'
  /// The ids of every ancestor on the placement path, root first, as JSON text: one read for "credit every ancestor".
  pathIdsJson          String    @default("[]")
  depth                Int       @default(0)
  /// Where this affiliate's own referrals are placed (§6.3).
  preferredLeg         String    @default("A")
  /// The leg of the sponsor that the sponsor's link named (§6.3); null when it named none. Read only to place this affiliate.
  requestedLeg         String?
  activatedAt          DateTime?
  /// The eligible course purchase that activated the affiliate (CV module, MLM-003).
  activationPurchaseId String?
  kycStatus            String    @default("none") // 'none' | 'submitted' | 'verified' | 'rejected'
  currentRankOrder     Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  student           Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sponsor           Affiliate?            @relation("AffiliateSponsor", fields: [sponsorId], references: [id], onDelete: Restrict)
  referrals         Affiliate[]           @relation("AffiliateSponsor")
  placementParent   Affiliate?            @relation("AffiliatePlacement", fields: [placementParentId], references: [id], onDelete: Restrict)
  placementChildren Affiliate[]           @relation("AffiliatePlacement")
  placementHistory  MlmPlacementHistory[]
  orders            MlmOrder[]
  cvLedger          MlmCvLedger[]
  legBalance        MlmLegBalance?
  matchingRuns      MlmMatchingRun[]
  rankHistory       MlmRankHistory[]
  rewards           MlmReward[]
  commissions       MlmCommission[]
  wallet            MlmWallet?
  walletEntries     MlmWalletEntry[]
  kyc               MlmKyc?
  withdrawals       MlmWithdrawal[]

  @@unique([placementParentId, placementLeg])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([sponsorId])
  @@index([placementParentId])
}

/// Every placement and move of an affiliate (MLM-002), append-only (triggers): where they came from, where they went,
/// by rule or by a person's hand, and why.
model MlmPlacementHistory {
  id           String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId     String
  affiliateId  String
  fromParentId String?
  fromLeg      String?
  toParentId   String?
  toLeg        String?
  reason       String // 'sponsor-direct' | 'spillover' | 'manual' | 'root'
  actorType    String   @default("system") // 'system' | 'user'
  actorId      String?
  note         String?
  createdAt    DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([affiliateId])
}

/// A verified sale of an eligible course (MLM-003): what it generated in CV and where it stands. Terms fixed and a
/// reversal final (triggers); never deleted.
model MlmOrder {
  id                       String    @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId                 String
  purchaseId               String    @unique
  buyerAffiliateId         String?
  sponsorAffiliateIdAtSale String?
  planVersionId            String
  netAmount                BigInt
  cv                       BigInt
  currency                 String    @default("INR")
  status                   String    @default("pending") // 'pending' | 'eligible' | 'reversed'
  paidAt                   DateTime
  eligibleAt               DateTime?
  reversedAt               DateTime?
  reversalReason           String? // 'refund' | 'chargeback' | 'manual'
  creditedAncestors        Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchase       CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  buyerAffiliate Affiliate?     @relation(fields: [buyerAffiliateId], references: [id], onDelete: Restrict)
  planVersion    MlmPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  ledger         MlmCvLedger[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([buyerAffiliateId])
  @@index([paidAt])
}

/// One ancestor's credit (or its reversal) for one order: the CV ledger, immutable (triggers).
model MlmCvLedger {
  id          String   @id @default(cuid())
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId    String
  affiliateId String
  leg         String // 'A' | 'B'
  orderId     String
  kind        String // 'sale' | 'reversal'
  amount      BigInt
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  order     MlmOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, affiliateId, kind])
  @@index([tenantId])
  @@index([affiliateId, createdAt])
}

/// An affiliate's running leg pools, rebuildable from the ledger: lifetime eligible CV per leg (ranks) and what is
/// still unmatched (carry-forward). The row is the lock for the affiliate's matching run.
model MlmLegBalance {
  affiliateId         String   @id
  /// The academy this row belongs to — see lib/tenancy.ts.
  tenantId            String
  lifetimeA           BigInt   @default(0)
  lifetimeB           BigInt   @default(0)
  unmatchedA          BigInt   @default(0)
  unmatchedB          BigInt   @default(0)
  matchedLifetime     BigInt   @default(0)
  lastMatchingRunDate String?
  version             Int      @default(0)
  updatedAt           DateTime @default(now()) @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

// ─── Course sales on the platform (docs/16 §2.4) ─────────────────────────

/// The last order number given out in a year.
model OrderSequence {
  year Int @id
  last Int @default(0)
}

model Coupon {
  id              String    @id @default(cuid())
  tenantId        String
  code            String
  description     String    @default("")
  /// 'percent' | 'fixed'. The code, the kind and the discount are fixed by trigger.
  kind            String
  percentBps      Int?
  amountOff       Int?
  startsAt        DateTime?
  endsAt          DateTime?
  maxUses         Int?
  perLearnerLimit Int       @default(1)
  courseId        String?
  /// 'active' | 'disabled'. Never deleted.
  status          String    @default("active")
  usedCount       Int       @default(0)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
}

/// One paid order's use of a coupon. Never changed or deleted.
model CouponRedemption {
  id             String   @id @default(cuid())
  tenantId       String
  couponId       String
  purchaseId     String   @unique
  studentId      String
  discountAmount Int
  createdAt      DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  coupon   Coupon         @relation(fields: [couponId], references: [id], onDelete: Restrict)
  purchase CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([couponId, studentId])
}

/// A refund of a whole order. At most one per purchase is under way or done; only a failed one leaves room for another.
model CoursePurchaseRefund {
  id               String    @id @default(cuid())
  tenantId         String
  purchaseId       String
  amount           Int
  reason           String
  note             String?
  requestedById    String?
  provider         String
  providerRefundId String?
  /// 'requested' | 'pending' | 'succeeded' | 'failed'
  status           String
  failureMessage   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  settledAt        DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchase CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([tenantId])
  @@index([purchaseId])
}

/// The public website's editable document (docs/16 §2.6): one per workspace.
model SiteContent {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  contentJson String
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
}

// ─── The public website's marketplace (docs/17) ─────────────────────────────

/// An image the Super Admin placed on the public website. Its presence is what lets `/public/images/:id` serve the file.
model SiteImage {
  id        String   @id @default(cuid())
  tenantId  String
  mediaId   String   @unique
  createdAt DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  media  MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// An article, resource, webinar, workshop, community note or career guide on the website.
model BlogPost {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String
  /// 'article' | 'resource' | 'webinar' | 'workshop' | 'community' | 'career'.
  kind        String    @default("article")
  title       String
  excerpt     String    @default("")
  body        String    @default("")
  coverUrl    String    @default("")
  /// Where a webinar is held or a resource lives; empty when the page itself is the content.
  externalUrl String    @default("")
  /// When a webinar or workshop takes place.
  eventAt     DateTime?
  /// 'draft' | 'published'. A published post with `publishAt` ahead stays hidden until then.
  status      String    @default("draft")
  publishAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, slug])
  @@index([status, publishAt])
}

/// Several courses sold together at one price. It earns no affiliate volume, so it may not hold an eligible course.
model CourseBundle {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  summary     String    @default("")
  description String    @default("")
  coverUrl    String    @default("")
  /// Whole rupees, all-inclusive, as a course's price is.
  price       Int
  /// 'draft' | 'published' | 'archived'. Bundles with orders are archived, never deleted.
  status      String    @default("draft")
  /// A published bundle with `publishAt` ahead stays hidden until then.
  publishAt   DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courses   CourseBundleCourse[]
  purchases BundlePurchase[]

  @@unique([tenantId, slug])
}

model CourseBundleCourse {
  id       String @id @default(cuid())
  tenantId String
  bundleId String
  courseId String
  order    Int    @default(0)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bundle CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([bundleId, courseId])
  @@index([tenantId])
  @@index([courseId])
}

/// One gateway order for a bundle. On payment each course gets a paid `CoursePurchase` child, whose amounts sum to `amount`.
model BundlePurchase {
  id                String    @id @default(cuid())
  tenantId          String
  studentId         String
  bundleId          String
  /// The charge in paise, fixed when the order is made.
  amount            Int
  currency          String    @default("INR")
  /// The bundle's price in whole rupees when the order was made, for the receipt.
  price             Int
  /// JSON array of `{ courseId, listPrice }` when the order was made: what this order buys, whatever the bundle becomes.
  termsJson         String
  provider          String
  environment       String
  providerOrderId   String
  providerPaymentId String?
  /// 'created' | 'paid' | 'expired'.
  status            String    @default("created")
  failureCode       String?
  failureMessage    String?
  reviewReason      String?
  orderNumber       String?   @unique
  /// 'requested' | 'pending' | 'succeeded' | 'failed'; null until a refund is asked for.
  refundStatus      String?
  providerRefundId  String?
  refundedAt        DateTime?
  chargebackAt      DateTime?
  paidAt            DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  bundle   CourseBundle     @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  children CoursePurchase[]

  @@unique([provider, providerOrderId])
  @@unique([provider, providerPaymentId])
  @@index([tenantId])
  @@index([studentId, bundleId])
  @@index([status, createdAt])
}

// ─── The affiliate program's earnings (docs/15 MLM-004 to MLM-007) ───

/// What one member's run saw and paid on one day (IST). One per member and day; immutable (triggers).
model MlmMatchingRun {
  id             String   @id @default(cuid())
  tenantId       String
  affiliateId    String
  runDate        String
  planVersionId  String
  rankOrderAtRun Int
  capBandKey     String
  availableA     BigInt
  availableB     BigInt
  matchedCv      BigInt
  grossIncome    BigInt
  dailyCap       BigInt
  cappedIncome   BigInt
  flushedCv      BigInt
  carryAAfter    BigInt
  carryBAfter    BigInt
  heldByCeiling  BigInt   @default(0)
  createdAt      DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@unique([affiliateId, runDate])
  @@index([tenantId, runDate])
}

/// Each rank a member reached, once. Append-only (triggers).
model MlmRankHistory {
  id            String   @id @default(cuid())
  tenantId      String
  affiliateId   String
  tierOrder     Int
  tierName      String
  lifetimeA     BigInt
  lifetimeB     BigInt
  planVersionId String
  achievedAt    DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@unique([affiliateId, tierOrder])
  @@index([tenantId, achievedAt])
}

/// A rank's reward on its way through approval, vesting, funding and payment.
model MlmReward {
  id            String    @id @default(cuid())
  tenantId      String
  affiliateId   String
  /// A plain id, written in the same transaction as the history row (the tenancy check reads committed rows).
  rankHistoryId String    @unique
  tierOrder     Int
  tierName      String
  groupCv       BigInt
  kind          String // 'recognition' | 'certificate' | 'cash'
  amount        BigInt
  capAmount     BigInt?
  vestingDays   Int       @default(0)
  status        String    @default("qualified") // 'qualified' | 'approved' | 'vesting' | 'funded' | 'paid' | 'rejected'
  vestsAt       DateTime?
  note          String?
  needsReview   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([affiliateId])
}

/// Every earning or reversal. Its money never changes; only a held one moves on (triggers).
model MlmCommission {
  id            String    @id @default(cuid())
  tenantId      String
  affiliateId   String
  kind          String // 'matching' | 'rank_reward' | 'reversal'
  /// Signed, minor units.
  amount        BigInt
  status        String // 'paid_to_wallet' | 'held' | 'written_off' | 'split'
  holdReason    String?
  /// The month (IST) it counts against the ceiling, once settled.
  period        String?
  heldPeriod    String?
  runId         String?
  rewardId      String?
  orderId       String?
  planVersionId String
  /// The hold this row was divided from.
  splitFromId   String?
  createdAt     DateTime  @default(now())
  settledAt     DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, period])
  @@index([affiliateId, createdAt])
}

/// Balances, a cache of the entries below that a nightly check compares with them.
model MlmWallet {
  affiliateId String   @id
  tenantId    String
  available   BigInt   @default(0)
  held        BigInt   @default(0)
  paid        BigInt   @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// The wallet's source of truth. Immutable (triggers).
model MlmWalletEntry {
  id             String   @id @default(cuid())
  tenantId       String
  affiliateId    String
  type           String
  availableDelta BigInt   @default(0)
  heldDelta      BigInt   @default(0)
  paidDelta      BigInt   @default(0)
  commissionId   String?
  withdrawalId   String?
  note           String?
  createdAt      DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([affiliateId, createdAt])
}

/// Identity and bank details. PAN and account number are sealed (lib/credentialVault.ts) and shown masked.
model MlmKyc {
  affiliateId      String    @id
  tenantId         String
  status           String    @default("submitted") // 'submitted' | 'verified' | 'rejected'
  legalName        String
  sealed           String
  sealedKeyId      String
  panLast4         String
  bankAccountLast4 String
  ifsc             String
  accountHolder    String
  upiId            String?
  documentIdsJson  String    @default("[]")
  rejectionReason  String?
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
}

/// Approved withdrawals grouped for one bank run.
model MlmPayoutBatch {
  id         String    @id @default(cuid())
  tenantId   String
  reference  String    @unique
  count      Int
  total      BigInt
  createdAt  DateTime  @default(now())
  exportedAt DateTime?
  closedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
}

/// A request against the available balance. One open per member; paid is final (triggers).
model MlmWithdrawal {
  id               String    @id @default(cuid())
  tenantId         String
  affiliateId      String
  amount           BigInt
  tdsAmount        BigInt    @default(0)
  netAmount        BigInt
  status           String    @default("requested")
  bankSnapshotJson String
  sealed           String
  sealedKeyId      String
  payoutBatchId    String?
  reference        String?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  decidedAt        DateTime?
  paidAt           DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([affiliateId])
}

/// What a program's jobs have finished, per workspace: the last matching day completed, the last nightly check.
model MlmProgramState {
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
}
