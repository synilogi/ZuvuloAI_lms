# ShubhLMS: credentials and machine-local files are never committed (modules.md §18, §24)
android/key.properties
android/local.properties
*.jks
*.keystore
*.p12
*.mobileprovision
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
config/*.local.json
.env*

# LIVE UI E2E evidence and local state (screenshots, logcat, test identities) — never committed
.live_e2e/
