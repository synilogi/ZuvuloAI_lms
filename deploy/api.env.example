# apps/api/.env on a server — bootstrap.sh fills every __PLACEHOLDER__ from its arguments and
# generates the two secrets. Values are per site; the template is the same for all of them.
NODE_ENV=production

# CloudPanel's vhost for the site proxies every path to this port.
PORT=__PORT__

# Absolute paths: the database and media live outside the checkout so deploys never touch them.
DATABASE_URL="file:__SITE__/data/prod.db"
UPLOAD_DIR=__SITE__/data/uploads

# The built web app, served by this process with the API under /api (see apps/api/src/web.ts).
# A symlink that deploy.sh swaps atomically to the newest build.
WEB_DIST=__SITE__/web

# bootstrap.sh replaces this with `openssl rand -hex 32`; the API refuses to start otherwise.
JWT_SECRET="__JWT_SECRET__"
JWT_EXPIRES_IN="7d"

# Exactly one origin — the web app's public URL.
CORS_ORIGIN="__PUBLIC__"
APP_URL="__PUBLIC__"

# Proxy hops in front of this process. Measure rather than assume: run a throwaway listener on
# PORT, send a request with a forged X-Forwarded-For and count the addresses appended after it.
# CloudPanel's nginx alone is 1; behind Cloudflare it is 2.
TRUST_PROXY=__TRUST_PROXY__

RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_MAX=30
# Failed sign-ins per account per window, from any client.
RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# Every email is written to the EmailOutbox table. Until a relay is set below, nothing is sent: registration codes,
# password resets and invitations stay in the outbox (the API warns at boot). Fill in your SMTP relay and switch to
# MAIL_TRANSPORT=smtp before opening self-serve registration, then prove delivery from the server with
#   npm run mail:test -w @syniastrolms/api -- you@example.com
# MAIL_FROM's domain needs SPF, DKIM and DMARC records for the relay, or codes land in spam.
MAIL_TRANSPORT=outbox
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ZuviloAI <noreply@example.com>"
# Self-registration verifies the email with a 6-digit code before any account exists — learners and instructors
# registering, and anyone joining through an invitation or course link. Leave on.
SIGNUP_EMAIL_VERIFICATION=on
# Never set TEST_OTP_EMAIL / TEST_OTP_CODE here: the API refuses to start in production with either (lib/testOtp.ts).
# Registrations an hour per email address, from any client (each one emails that address a code).
RATE_LIMIT_EMAIL_MAX=10
# The platform's one workspace (docs/16, D-PLAT-01), and where the website's contact and support requests are emailed.
DEFAULT_TENANT_SLUG=default
# OTP_CHANNEL=email
# SALES_NOTIFY_EMAIL="sales@example.com"
# PLATFORM_REPLY_TO="support@example.com"
# Push notifications: `fcm`, with the Firebase service-account JSON (raw or base64) in FCM_SERVICE_ACCOUNT.
PUSH_PROVIDER=
FCM_SERVICE_ACCOUNT=

# Android App Links (/.well-known/assetlinks.json, apps/api/src/lib/appLinks.ts): the SHA-256 of the certificate
# Google Play signs the app with (Play Console › Test and release › App integrity › App signing key certificate),
# comma-separated if the upload key should verify too. Unset, the file 404s and join/reset links open the browser.
# deploy.sh writes it to <site>/.well-known/assetlinks.json, because the CloudPanel vhost serves that folder itself.
# ANDROID_APP_LINK_SHA256=
# ANDROID_APP_LINK_PACKAGES=com.shubhlms.mobile

# Database backups (npm run db:backup; deploy.sh takes one before every migration): kept under __SITE__/data/backups.
# DB_BACKUP_KEEP=14

# Single API instance, so the in-process scheduler stays on.
LIVE_REMINDERS=on

# ── Course sales (docs/16 §2.4). Secrets are written here on the server only, never committed.
# Online payment: the key that encrypts payment-gateway credentials — `openssl rand -hex 32`.
# The gateways themselves (Razorpay's keys and webhook secret, which gateway is active) are configured by a
# Super Admin at /superadmin/payment-gateways, never here. Keep this key with the deployment's other secrets:
# rotating or losing it means re-entering every gateway's credentials. A deployment that still has
# RAZORPAY_* set: run `npm run gateways:import-env -w @syniastrolms/api` once, then remove them.
PAYMENT_CREDENTIALS_KEY="__PAYMENT_CREDENTIALS_KEY__"
# GitHub push webhook -> deploy.sh (see apps/api/src/routes/deploy-webhook.ts). Unset disables
# the route entirely (404). bootstrap.sh generates the secret; the same value goes on the GitHub
# webhook (Settings -> Webhooks). DEPLOY_BRANCH must match deploy.conf's BRANCH so pushes to
# other branches are ignored instead of deployed.
DEPLOY_WEBHOOK_SECRET="__WEBHOOK_SECRET__"
DEPLOY_BRANCH="__BRANCH__"

# The built-in live room (docs/modules/live-classes.md). Unset, the built-in room is OFF in production: start and join
# answer 503 LIVE_ROOM_NOT_CONFIGURED (outside-meeting links still work). LIVE_ROOM_PUBLIC_JITSI=allow would put it on
# the public meet.jit.si instead, where a host must sign in to Jitsi and learners wait in its lobby. For real classes set JaaS
# (8x8 Jitsi as a Service — jaas.8x8.vc): every join is then signed and the host moderates. The webhook secret
# (JaaS Console → Webhooks → <PUBLIC>/api/webhooks/jaas, RECORDING_UPLOADED) keeps recordings.
# JAAS_APP_ID=vpaas-magic-cookie-...
# JAAS_KID=
# JAAS_PRIVATE_KEY_FILE=/home/<user>/secrets/jaas-private.pem
# JAAS_WEBHOOK_SECRET=
# LIVE_RECORDING_DAYS=30
