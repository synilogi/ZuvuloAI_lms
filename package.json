{
  "name": "syniastrolms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @syniastrolms/web",
    "build": "npm run build -w @syniastrolms/web",
    "preview": "npm run preview -w @syniastrolms/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w @syniastrolms/web",
    "format": "prettier --write \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/src/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/src/**/*.{ts,tsx,css}\" \"packages/**/src/**/*.ts\"",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.70.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
